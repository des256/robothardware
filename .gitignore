# JLCPCB parts database (~450 MB, rebuilt anytime via kkh-download-jlcpcb-parts-database)
jlcpcb_parts.db

# kkh check/build outputs: outputs/<date-revision>/ (reports, gerbers, PDFs, STEP)
# and production/ (Fabrication Toolkit scratch). kkh skips both when discovering boards.
backbone/outputs/
backbone/production/

# KiCad backups and caches
*-backups/
*.kicad_sch-bak
*.kicad_pcb-bak
fp-info-cache
~*.lck
_autosave-*

# KiCad 10 local design history (has its own .git; per-machine, not project data)
backbone/.history/
