	(text "BUCK B — +5V_SERVO, 10 A continuous, 200 kHz. Copy of TI LM5145 datasheet Application Circuit 1 (5 V/20 A) and the LM5145EVM-HD-20A:\nsame controller passives, Q1/Q2 CSD18532Q5B, 3.3 µH 30 A inductor, 5 × 2.2 µF/100 V in, 6 × 47 µF/10 V + 470 µF/10 V polymer out.\nRILIM 150 Ω with 2.5 mΩ RDS(on) → valley current limit near 12 A. Separate sheet on purpose: values differ and D1 option (b) deletes this rail.\nNEVER merged with +5V_USB (HARDWARE.md §5). SYNCIN jumper as on Buck A. Net names SW / BOOT → SW_NODE class.\nOpen items: D1, V3."
		(exclude_from_sim no)
		(at 12.7 12.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f4a4cb44-1fbf-547d-8909-c7353fd515b7")
	)
